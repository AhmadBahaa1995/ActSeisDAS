{"cells":[{"cell_type":"code","source":"\"\"\"\nEdgeDAS: An Automated Onsite Processing Framework for Distributed Acoustic Sensing (DAS) Data\n\nThis script provides a comprehensive framework for the automated processing of Distributed\nAcoustic Sensing (DAS) data. It is designed to run on an edge computing device located\nonsite, enabling near-real-time analysis of seismic data.\n\nThe framework includes the following key features:\n- A graphical user interface (GUI) built with Tkinter for easy configuration.\n- Automated file discovery and processing of raw binary DAS data.\n- Parallel processing capabilities using multiprocessing to leverage multi-core CPUs\n  for efficient cross-correlation.\n- Cross-correlation of continuous DAS data against a reference source signal to\n  generate virtual shot gathers.\n- Options for both standard and binary (one-bit) cross-correlation.\n- Stacking of shot gathers over user-defined time periods (e.g., hours) to improve\n  the signal-to-noise ratio.\n- Automated generation and saving of seismogram plots for quality control.\n- A scheduling feature to run the processing pipeline automatically at a specified\n  time each day.\n- Persistent settings, allowing the application to remember the last used\n  configuration.\n- Custom logging to keep a record of processing activities.\n\nWorkflow:\n1. The user configures processing parameters via the GUI (e.g., data folder,\n   shot interval, stacking duration).\n2. Upon clicking \"Run,\" the application starts an initial processing run and\n   schedules subsequent daily runs in a background thread to keep the GUI responsive.\n3. The script identifies unprocessed days by comparing the data folders against a log file.\n4. For each unprocessed day, it distributes the workload across multiple CPU cores. Each\n   core processes one hour of data.\n5. In each processing task, the raw binary data is read, downsampled, filtered, and\n   cross-correlated with a source signal to create shot gathers.\n6. The resulting shot gathers (in MSEED format) are saved to disk.\n7. After cross-correlation, the script stacks the hourly shot gathers over a\n   user-defined period.\n8. Finally, it generates a seismogram plot of the stacked data for visual inspection\n   and saves both the plot and the stacked MSEED file.\n\"\"\"\n\nimport logging\nimport os\nimport struct\nimport numpy as np\nimport schedule\nimport time\nimport matplotlib.pyplot as plt\nimport gc\nimport sys\nimport psutil\nimport tkinter as tk\nimport threading\n\nfrom tkinter import filedialog, messagebox, OptionMenu, StringVar, BooleanVar, Checkbutton\nfrom tempfile import NamedTemporaryFile\nfrom scipy.signal import butter, lfilter, correlate, coherence, minimum_phase, hilbert, find_peaks\nfrom scipy.fftpack import fft, fftfreq\nfrom obspy import UTCDateTime, read, Stream, Trace\nfrom obspy.signal import cross_correlation\nfrom multiprocessing import Pool, cpu_count\nfrom tqdm import tqdm\nfrom datetime import datetime\nfrom functools import partial\n\nclass ReverseOrderLogger:\n    \"\"\"\n    A custom logger to prepend log messages to a log file.\n    This logger ensures that new log messages appear at the top of the file.\n\n    Note: This method can be inefficient for very large log files as it requires\n    reading and rewriting the entire file for each log entry.\n    \"\"\"\n    def __init__(self, log_file):\n        self.log_file = log_file\n\n    def log(self, level, message):\n        \"\"\"\n        Logs a message to the log file with the specified level.\n\n        Args:\n            level (str): The log level (e.g., 'INFO', 'ERROR').\n            message (str): The message to log.\n        \"\"\"\n        timestamp = datetime.now().strftime('%Y-%m-%d %H:%M:%S')\n        log_entry = f\"{timestamp} - {level} - {message}\\n\"\n\n        # Read existing content\n        try:\n            with open(self.log_file, 'r') as f:\n                existing_content = f.read()\n        except FileNotFoundError:\n            existing_content = ''\n\n        # Prepend the new log entry\n        with open(self.log_file, 'w') as f:\n            f.write(log_entry + existing_content)\n\n    def info(self, message):\n        self.log('INFO', message)\n\n    def error(self, message):\n        self.log('ERROR', message)\n\n    def warning(self, message):\n        self.log('WARNING', message)\n\n# --- Global Setup ---\n# Ensure the log directory exists\nos.makedirs('_log', exist_ok=True)\n# Set up the custom logger\nlog_file_path = '_log/processing_log.txt'\nlogger = ReverseOrderLogger(log_file_path)\n\nclass PrintLogger:\n    \"\"\"\n    A custom class that intercepts print statements and logs them.\n    This allows any `print()` call in the script to be automatically written\n    to both the console and the log file.\n    \"\"\"\n    def write(self, message):\n        \"\"\"\n        Intercepts the message passed to print and logs it.\n        \"\"\"\n        if message.strip():  # Ignore empty messages\n            sys.__stdout__.write(message)  # Print the message to the console\n            logger.info(message.strip())  # Log the message to the file\n\n    def flush(self):\n        \"\"\"\n        Ensures output is flushed to the console.\n        \"\"\"\n        sys.__stdout__.flush()\n\n# Redirect standard print output to our custom PrintLogger\nsys.stdout = PrintLogger()\n\n# --------------------------------------------------------------------------------------------------------- #\ndef find_list_difference(list1, list2):\n    \"\"\"\n    Finds elements that are in list1 but not in list2.\n\n    Args:\n        list1 (list): The primary list.\n        list2 (list): The list of elements to exclude.\n\n    Returns:\n        list: A list containing elements unique to list1.\n    \"\"\"\n    return list(set(list1) - set(list2))\n\n# --------------------------------------------------------------------------------------------------------- #\ndef plot_seismogram(ax, data, offset, time, plot_option=1, cmap='seismic', title=None):\n    \"\"\"\n    A versatile function to plot seismic data in various formats.\n\n    Args:\n        ax (matplotlib.pyplot.Axes): The axes object to plot on.\n        data (np.ndarray): 2D array of seismogram amplitudes (time x traces).\n        offset (np.ndarray): 1D array of trace offsets/channel numbers.\n        time (np.ndarray): 1D array of time values for the y-axis.\n        plot_option (int or str): Defines the plot type:\n            - 0 or 'wiggle': Wiggle trace plot.\n            - 1 or 'color': Color map image plot (default).\n            - 2 or 'both': Both wiggle and color plots side-by-side.\n            - 3 or 'stacked': A single trace representing the sum of all traces.\n        cmap (str): Colormap for the color plot.\n        title (str): Title for the plot.\n    \"\"\"\n    # --- Nested plotting functions for organization ---\n    def wiggle(ax, data, time):\n        \"\"\"Plots data as wiggle traces.\"\"\"\n        for i in range(data.shape[1]):\n            # Normalize and shift each trace for visualization\n            trace_norm = data[:, i] / (np.max(np.abs(data[:, i])) + 1e-9)\n            ax.plot(trace_norm + i, time, linewidth=0.3, c='k')\n            # Fill the positive wiggles\n            ax.fill_betweenx(time, trace_norm + i, i, where=(trace_norm + i >= i), color='k', lw=0)\n        ax.invert_yaxis()\n        ax.set_ylabel('Time [s]')\n        ax.set_xlabel('Trace Number')\n\n    def color(ax, data, time, offset):\n        \"\"\"Plots data as a color image.\"\"\"\n        # Calculate a robust color limit based on the 98th percentile\n        clim = np.percentile(np.abs(data), 98)\n        ax.imshow(data, cmap=cmap,\n                  extent=[np.min(offset), np.max(offset), np.max(time), np.min(time)],\n                  aspect='auto', vmin=-clim, vmax=clim)\n        ax.set_ylabel('Time [s]')\n        ax.set_xlabel('Trace Number')\n\n    def stack_seismogram(ax, data, time):\n        \"\"\"Plots the stacked (summed) trace of all channels.\"\"\"\n        stacked_trace = data.sum(axis=1)\n        ax.plot(stacked_trace, time, lw=0.5, color='k')\n        ax.fill_betweenx(time, stacked_trace, 0, where=(stacked_trace > 0), color='k', lw=0)\n        ax.set_xlabel('Stacked Amplitude')\n        ax.set_ylabel('Time [s]')\n        ax.invert_yaxis()\n\n    # --- Main plotting logic ---\n    plt.rcParams[\"figure.figsize\"] = [12, 6]\n    if plot_option == 0 or plot_option == 'wiggle':\n        wiggle(ax, data, time)\n    elif plot_option == 1 or plot_option == 'color':\n        color(ax, data, time, offset)\n    elif plot_option == 2 or plot_option == 'both':\n        fig, (ax1, ax2) = plt.subplots(nrows=1, ncols=2, sharey=True, figsize=(15, 7))\n        wiggle(ax1, data, time)\n        color(ax2, data, time, offset)\n        if title:\n            fig.suptitle(title)\n        return # Return early as subplots handle their own titles\n    elif plot_option == 3 or plot_option == 'stacked':\n        stack_seismogram(ax, data, time)\n\n    if title:\n        ax.set_title(title)\n\n# --------------------------------------------------------------------------------------------------------- #\ndef plot_CC(merged_data, target_day, StartTime, EndTime):\n    \"\"\"\n    Plots and saves the final stacked cross-correlation seismogram.\n\n    Args:\n        merged_data (obspy.Stream): A Stream object containing the stacked seismic data.\n        target_day (str): The day being processed (YYYYMMDD format).\n        StartTime (obspy.UTCDateTime): The start time of the stacked data.\n        EndTime (obspy.UTCDateTime): The end time of the stacked data.\n    \"\"\"\n    try:\n        # Define plot title and a filesystem-safe version\n        start_str = StartTime.strftime('%Y-%m-%dT%H-%M-%S')\n        end_str = EndTime.strftime('%H-%M-%S')\n        title = f\"Stacked CC: {target_day} from {start_str} to {end_str}\"\n        safe_title = title.replace(\":\", \"-\").replace(\" \", \"_\")\n\n        print(f\"\\nCreating plot: {title}\")\n\n        # Prepare data for plotting\n        merged_data.normalize()\n        fig, ax = plt.subplots(figsize=(12, 6))\n        \n        # Convert Stream to a 2D numpy array for plotting\n        plot_data = np.array([tr.data for tr in merged_data]).T\n        \n        # Create time axis for the plot (centered at t=0)\n        sr = merged_data[0].stats.sampling_rate\n        npts = merged_data[0].stats.npts\n        time_axis = np.arange(-npts / 2 / sr, npts / 2 / sr, 1 / sr)\n        \n        # Create offset axis (channel numbers)\n        offset_axis = np.arange(len(merged_data))\n\n        plot_seismogram(\n            ax,\n            plot_data,\n            offset=offset_axis,\n            time=time_axis,\n            cmap=\"seismic\",\n            plot_option=1,\n            title=title,\n        )\n\n        # Save the figure\n        output_directory = os.path.join(\"_log\", \"Saved_data\", \"Seismogram_Plots\")\n        os.makedirs(output_directory, exist_ok=True)\n        save_path = os.path.join(output_directory, safe_title + \".png\")\n        plt.savefig(save_path, dpi=300, bbox_inches='tight')\n        plt.close(fig)\n        print(f\"\\nSaved seismogram plot at {save_path}\")\n\n        # Save the stacked cross-correlation data as an MSEED file\n        cc_output_directory = os.path.join(\"_log\", \"Saved_data\", \"Stacked_Cross_Correlation\")\n        os.makedirs(cc_output_directory, exist_ok=True)\n        file_path = os.path.join(cc_output_directory, f\"{safe_title}.mseed\")\n        merged_data.write(file_path, format=\"MSEED\")\n        print(f\"\\nSaved stacked CC data at {file_path}\")\n\n    except Exception as e:\n        print(f\"\\nError creating plot or saving data for {title}: {e}\")\n\n    finally:\n        # Log that this day has been processed\n        log_path = os.path.join(\"_log\", \"donedays.txt\")\n        with open(log_path, \"a\") as log_file:\n            log_file.write(f\"{target_day}, finished at: {datetime.now()}\\n\")\n        print(f\"\\nFinished processing for day: {target_day}\")\n\n# --------------------------------------------------------------------------------------------------------- #\ndef stacking(stacked_hours, available_Hr_Path, target_day):\n    \"\"\"\n    Reads hourly cross-correlation files and stacks them over a specified period.\n\n    Args:\n        stacked_hours (int): The number of hours of data to combine into one stack.\n        available_Hr_Path (str): Path to the directory containing hourly CC data for the day.\n        target_day (str): The day being processed (YYYYMMDD).\n    \"\"\"\n    available_hr_folders = sorted(os.listdir(available_Hr_Path))\n    data_container = Stream()\n    read_hr_counter = 0\n    shots_generated = 0 # Initialize counter\n\n    print(f\"\\nStarting stacking process for data in {available_Hr_Path}\")\n\n    for hr_folder in tqdm(available_hr_folders, desc=\"Stacking hours\"):\n        hr_path = os.path.join(available_Hr_Path, hr_folder)\n        if not os.path.isdir(hr_path):\n            continue\n\n        # Read all MSEED files within the hour folder\n        for data_file in sorted(os.listdir(hr_path)):\n            file_path = os.path.join(hr_path, data_file)\n            if os.path.isfile(file_path) and data_file.endswith(\".mseed\"):\n                try:\n                    data_container += read(file_path)\n                except Exception as e:\n                    print(f\"Warning: Could not read file {file_path}. Error: {e}\")\n        \n        read_hr_counter += 1\n\n        # When enough hours have been read, perform stacking\n        if read_hr_counter > 0 and read_hr_counter % stacked_hours == 0:\n            print(f\"\\nStacking data for a {read_hr_counter}-hour block...\")\n            StartTime = data_container[0].stats.starttime\n            EndTime = data_container[-1].stats.endtime\n            \n            data_container.stack('id') # Stack traces with the same station ID\n            shots_generated += 1\n\n            plot_CC(data_container, target_day, StartTime, EndTime)\n            \n            # Free memory and reset the container for the next block\n            del data_container\n            gc.collect()\n            data_container = Stream()\n            read_hr_counter = 0 # Reset counter for next block\n\n    # Handle any remaining data that didn't form a full block\n    if len(data_container) > 0:\n        print(f\"\\nStacking remaining {read_hr_counter} hour(s) of data...\")\n        StartTime = data_container[0].stats.starttime\n        EndTime = data_container[-1].stats.endtime\n        \n        data_container.stack('id')\n        shots_generated += 1\n\n        plot_CC(data_container, target_day, StartTime, EndTime)\n        \n        del data_container\n        gc.collect()\n\n    print(f\"\\nStacking complete for day: {target_day}. Generated {shots_generated} stacked seismic shot gathers.\")\n    return None\n\n# --------------------------------------------------------------------------------------------------------- #\n# --- Main Processing Functions ---\n# --------------------------------------------------------------------------------------------------------- #\ndef process_channel_chunk(args):\n    \"\"\"\n    Worker function to process one hour of raw binary data.\n    This function is executed in parallel by the multiprocessing pool.\n\n    It reads binary files, performs cross-correlation against a reference signal,\n    and saves the resulting virtual shot gathers as MSEED files.\n\n    Args:\n        args (tuple): A tuple containing the function arguments:\n            - hour_folder (str): Path to the folder for a specific hour.\n            - shotting_interval (int): Time interval between shots in seconds.\n            - day_folder (str): Parent day folder path.\n            - shift_seconds (int): Time shift for aligning data windows.\n            - source_pass (obspy.Stream): The reference source signal for CC.\n            - use_binary_cc (bool): If True, performs one-bit cross-correlation.\n    \"\"\"\n    hour_folder, shotting_interval, day_folder, shift_seconds, source_pass, use_binary_cc = args\n\n    # Define the save path for the hourly cross-correlation results\n    day_str = os.path.basename(day_folder)\n    hour_str = os.path.basename(hour_folder)\n    save_path = os.path.join('_log', 'Saved_data', 'Cross_Correlation_folder', day_str, hour_str)\n    os.makedirs(save_path, exist_ok=True)\n\n    try:\n        file_list = sorted(os.listdir(hour_folder))\n        # Use tqdm for a progress bar within the worker\n        for file_name in tqdm(file_list, desc=f'Processing {hour_str}', leave=False):\n            file_path = os.path.join(hour_folder, file_name)\n            if not os.path.isfile(file_path):\n                continue\n            \n            try:\n                # Parse datetime from the filename to get precise start time\n                dt = datetime.strptime(file_name, \"%Y%m%d%H%M%S%f\")\n                sec = dt.second\n                microsec = dt.microsecond\n                # This shift helps align the start of the recording to the top of the minute\n                record_shift_seconds = 60 - (sec + microsec / 1_000_000)\n\n                # Read the custom binary data format\n                with open(file_path, 'br') as f:\n                    all_channels_stream = Stream()\n                    \n                    # NOTE: The following structure is specific to the binary file format.\n                    # It assumes a fixed number of channels and a specific header structure.\n                    num_channels_expected = 1200 # This should be a parameter if it can change.\n                    \n                    # Unpack the entire file's data into a flat list\n                    all_data_flat = []\n                    # Header: 2 integers (num_sections, num_samples) per channel\n                    header_size_per_channel = 8 # bytes (2 * 4-byte integers)\n                    # Loop through each channel's data block\n                    for _ in range(num_channels_expected):\n                        header = f.read(header_size_per_channel)\n                        if not header: break # End of file\n                        num_sections, num_samples = struct.unpack('<ii', header)\n                        \n                        # Calculate total samples for this channel and read them\n                        total_samples = num_sections * num_samples\n                        channel_raw_data = f.read(total_samples * 4) # 4 bytes per float\n                        channel_data = list(struct.unpack(f'<{total_samples}f', channel_raw_data))\n                        all_data_flat.extend(channel_data)\n\n                # De-interleave the flat data into separate channels\n                total_points = len(all_data_flat) // num_channels_expected\n                all_data_reshaped = np.array(all_data_flat).reshape(num_channels_expected, total_points)\n                \n                # Process each channel\n                for i in range(num_channels_expected):\n                    # Downsample by taking every 4th sample. Original SR is likely 1000Hz.\n                    channel_data_downsampled = all_data_reshaped[i, ::4]\n                    \n                    trace = Trace(data=channel_data_downsampled)\n                    trace.stats.station = f\"{i:04d}\"\n                    trace.stats.sampling_rate = 250 # New SR after downsampling\n                    trace.stats.starttime = UTCDateTime(dt)\n                    \n                    # Apply a high-pass filter to remove low-frequency noise\n                    trace.filter('highpass', freq=2, corners=4)\n\n                    # Use a sliding window to extract segments for cross-correlation\n                    for window in trace.slide(window_length=29.996, step=shotting_interval,\n                                              offset=record_shift_seconds + shift_seconds,\n                                              include_partial_windows=False, nearest_sample=True):\n                        \n                        # Perform cross-correlation\n                        if use_binary_cc:\n                            # One-bit cross-correlation: clip data to -1, 0, or 1\n                            window_rms = np.sqrt(np.mean(window.data**2))\n                            window_thresholded = np.where(np.abs(window.data) > window_rms, np.sign(window.data), 0)\n                            source_pass_rms = np.sqrt(np.mean(source_pass[0].data**2))\n                            source_pass_thresholded = np.where(np.abs(source_pass[0].data) > source_pass_rms, np.sign(source_pass[0].data), 0)\n                            cc_data, _ = cross_correlation.correlate(window_thresholded, source_pass_thresholded, shift=1250, demean=False, normalize=None)\n                        else:\n                            # Standard cross-correlation\n                            cc_data, _ = cross_correlation.correlate(window, source_pass[0], shift=1250)\n                        \n                        # Create a new trace with the CC result, trimming to a specific length\n                        # The slice [250:2250] keeps a symmetric window around the zero lag\n                        cc_trace = Trace(data=cc_data[250:2250])\n                        cc_trace.stats.station = window.stats.station\n                        cc_trace.stats.starttime = window.stats.starttime\n                        cc_trace.stats.sampling_rate = window.stats.sampling_rate\n                        all_channels_stream += cc_trace\n\n                # Save the processed shot gather for this time window\n                if len(all_channels_stream) > 0:\n                    formatted_starttime = str(all_channels_stream[0].stats.starttime).replace(':', '-').split('.')[0]\n                    output_filename = f'{formatted_starttime}.mseed'\n                    all_channels_stream.write(os.path.join(save_path, output_filename), format='MSEED')\n\n                # Clean up memory\n                del all_data_flat, all_data_reshaped, all_channels_stream\n                gc.collect()\n\n            except Exception as e:\n                print(f\"Error processing file {file_name}: {e}\")\n\n    except Exception as e:\n        print(f\"Error processing hour folder {hour_folder}: {e}\")\n\n    return None\n\n# --------------------------------------------------------------------------------------------------------- #\ndef distribute_work(day_folder, shift_seconds, shotting_interval, target_day, stacked_hours, use_binary_cc, cores):\n    \"\"\"\n    Distributes the processing of one day's data across multiple CPU cores.\n    \n    Args:\n        day_folder (str): Path to the day's data folder.\n        shift_seconds (int): Time shift for data window alignment.\n        shotting_interval (int): Interval between shots in seconds.\n        target_day (str): The day being processed (YYYYMMDD).\n        stacked_hours (int): The number of hours to stack together.\n        use_binary_cc (bool): Flag for using binary cross-correlation.\n        cores (int): Number of CPU cores to use for parallel processing.\n    \"\"\"\n    source_file = os.path.join('_log', 'source_pass.mseed')\n    if not os.path.exists(source_file):\n        print(f\"ERROR: Source signal file not found at {source_file}. Cannot proceed.\")\n        messagebox.showerror(\"Error\", f\"Source file not found:\\n{source_file}\")\n        return\n\n    source_pass = read(source_file)\n    # Trim the source to match the window length used in processing\n    source_pass.trim(endtime=source_pass[0].stats.starttime + 29.996)\n\n    hour_list = sorted([h for h in os.listdir(day_folder) if os.path.isdir(os.path.join(day_folder, h))])\n    \n    # Adjust core count based on available hours\n    if len(hour_list) < cores:\n        cores = len(hour_list)\n    print(f\"\\nUsing {cores} cores for parallel processing of {len(hour_list)} hours.\")\n\n    # Prepare arguments for each worker process\n    args = [(os.path.join(day_folder, hour), shotting_interval, day_folder, shift_seconds, source_pass, use_binary_cc) for hour in hour_list]\n    \n    # Run cross-correlation in parallel\n    with Pool(cores) as pool:\n        # pool.map will block until all tasks are complete\n        _ = pool.map(process_channel_chunk, args)\n    \n    print(f\"\\nFinished cross-correlation for all hours in {target_day}.\")\n\n    # --- Stacking Phase ---\n    available_Hr_Path = os.path.join('_log', 'Saved_data', 'Cross_Correlation_folder', os.path.basename(day_folder))\n    if not os.path.exists(available_Hr_Path):\n        print(f\"Warning: No cross-correlation data found for {target_day}. Skipping stacking.\")\n        return\n\n    available_hr = sorted(os.listdir(available_Hr_Path))\n\n    if len(available_hr) < stacked_hours:\n        print(f\"\\nWarning: Only {len(available_hr)} hours of data are available.\")\n        print(f\"Stacking will proceed with {len(available_hr)} hours instead of the requested {stacked_hours}.\")\n        stacked_hours = len(available_hr)\n    \n    if stacked_hours > 0:\n        stacking(stacked_hours, available_Hr_Path, target_day)\n    else:\n        print(\"\\nNo data available to stack.\")\n\n    return None\n\n# --------------------------------------------------------------------------------------------------------- #\ndef process_seismic_data(shift_seconds, shotting_interval, target_recorded, stacked_hours, use_binary_cc, cores):\n    \"\"\"\n    Main function to orchestrate the entire data processing workflow.\n    It identifies which days need processing and calls the distributor function for each.\n    \n    Args:\n        shift_seconds (int): See `distribute_work`.\n        shotting_interval (int): See `distribute_work`.\n        target_recorded (str): Path to the root folder containing daily data folders.\n        stacked_hours (int): See `distribute_work`.\n        use_binary_cc (bool): See `distribute_work`.\n        cores (int): See `distribute_work`.\n    \"\"\"\n    print(\"\\n--- Starting Seismic Data Processing Workflow ---\")\n    \n    # Find all available days in the target directory\n    day_list = sorted([d for d in os.listdir(target_recorded) if os.path.isdir(os.path.join(target_recorded, d))])\n    \n    # The slice [:-2] is likely intended to prevent processing of the most recent\n    # two days, which might still be actively recording and thus incomplete.\n    day_list = day_list[:-2]\n    \n    # Read the log of already processed days\n    log_path = os.path.join('_log', 'donedays.txt')\n    if not os.path.exists(log_path):\n        open(log_path, 'w').close() # Create the file if it doesn't exist\n\n    done_days = []\n    with open(log_path, 'r') as f:\n        for line in f:\n            if line.strip():\n                done_days.append(line.strip().split(',')[0])\n\n    # Determine which days are new and need processing\n    target_days = sorted(find_list_difference(day_list, done_days))\n    \n    if not target_days:\n        print(\"\\nNo new days to process. All available data has been processed.\")\n        return\n\n    print(f\"\\nFound {len(target_days)} new day(s) to process: {target_days}\")\n\n    for target_day in tqdm(target_days, desc=\"Processing Days\"):\n        print(f\"\\n--- Starting processing for day: {target_day} ---\")\n        day_folder = os.path.join(target_recorded, target_day)\n        distribute_work(day_folder, shift_seconds, shotting_interval, target_day, stacked_hours, use_binary_cc, cores)\n\n    print(\"\\n--- All new seismic data has been processed. ---\")\n\n\n# --------------------------------------------------------------------------------------------------------- #\ndef schedule_daily_processing(run_time, shift_seconds, shotting_interval, target_folder, hours_to_stack, use_binary_cc, cores):\n    \"\"\"\n    Schedules the main processing function to run daily at a specified time.\n    This function itself runs in a loop and should be started in a background thread.\n    \n    Args:\n        run_time (str): The time to run the job, in \"HH:MM\" format.\n        (Other args are passed through to `process_seismic_data`)\n    \"\"\"\n    # Schedule the job\n    schedule.every().day.at(run_time).do(\n        process_seismic_data,\n        shift_seconds=shift_seconds,\n        shotting_interval=shotting_interval,\n        target_recorded=target_folder,\n        stacked_hours=hours_to_stack,\n        use_binary_cc=use_binary_cc,\n        cores=cores\n    )\n    print(f\"\\nProcessing has been scheduled to run daily at {run_time}.\")\n    \n    # This loop is what executes the scheduled jobs. It must run continuously.\n    while True:\n        schedule.run_pending()\n        time.sleep(1)\n\n# --------------------------------------------------------------------------------------------------------- #\ndef save_settings(shift_seconds, shotting_interval, target_folder, hours_to_stack, run_time, use_binary_cc, cores):\n    \"\"\"Saves the current GUI settings to a file for persistence.\"\"\"\n    try:\n        with open(SETTINGS_FILE, 'w') as f:\n            f.write(f\"shift_seconds={shift_seconds}\\n\")\n            f.write(f\"shotting_interval={shotting_interval}\\n\")\n            f.write(f\"target_folder={target_folder}\\n\")\n            f.write(f\"hours_to_stack={hours_to_stack}\\n\")\n            f.write(f\"run_time={run_time}\\n\")\n            f.write(f\"use_binary_cc={use_binary_cc}\\n\")\n            f.write(f\"cores={cores}\\n\")\n        print(\"\\nProcessing settings saved.\")\n    except Exception as e:\n        print(f\"\\nError saving settings: {e}\")\n\n# --------------------------------------------------------------------------------------------------------- #\ndef load_settings():\n    \"\"\"Loads processing settings from the file to populate the GUI.\"\"\"\n    settings = {}\n    if os.path.exists(SETTINGS_FILE):\n        try:\n            with open(SETTINGS_FILE, 'r') as f:\n                for line in f:\n                    if \"=\" in line:\n                        key, value = line.strip().split(\"=\", 1)\n                        settings[key] = value\n            print(\"\\nProcessing settings loaded from file.\")\n        except Exception as e:\n            print(f\"\\nError loading settings: {e}\")\n    return settings\n\n# --------------------------------------------------------------------------------------------------------- #\n# --- GUI Application ---\n# --------------------------------------------------------------------------------------------------------- #\nif __name__ == \"__main__\":\n    SETTINGS_FILE = \"_log/processing_settings.txt\"\n\n    def start_processing_thread():\n        \"\"\"\n        Wrapper function to get GUI values and start the processing and scheduling\n        in a background thread to prevent the GUI from freezing.\n        \"\"\"\n        try:\n            # --- Get all values from GUI ---\n            shift_seconds = int(shift_seconds_entry.get())\n            shotting_interval = int(shotting_interval_entry.get())\n            target_folder = target_folder_entry.get()\n            hours_to_stack = int(hours_stack_var.get() or 24) # Default to 24 if blank\n            selected_hour = hour_var.get()\n            selected_minute = minute_var.get()\n            run_time = f\"{selected_hour}:{selected_minute}\"\n            cores = int(cores_entry.get() or cpu_count()) # Default to max CPUs\n            use_binary_cc = binary_cc_var.get()\n\n            # --- Validate inputs ---\n            if not os.path.isdir(target_folder):\n                messagebox.showerror(\"Error\", \"Target folder path is invalid.\")\n                return\n\n            # --- Save settings and show confirmation ---\n            save_settings(shift_seconds, shotting_interval, target_folder, hours_to_stack, run_time, use_binary_cc, cores)\n            messagebox.showinfo(\"Processing Started\", \"Seismic data processing has started in the background.\\nThe application will also run automatically every day.\")\n\n            # --- Define the target for the background thread ---\n            def background_task():\n                # 1. Run the processing immediately once\n                process_seismic_data(\n                    shift_seconds=shift_seconds,\n                    shotting_interval=shotting_interval,\n                    target_recorded=target_folder,\n                    stacked_hours=hours_to_stack,\n                    use_binary_cc=use_binary_cc,\n                    cores=cores\n                )\n                # 2. Start the daily scheduler loop\n                schedule_daily_processing(\n                    run_time, shift_seconds, shotting_interval, target_folder, hours_to_stack, use_binary_cc, cores\n                )\n\n            # --- Create and start the thread ---\n            # The `daemon=True` ensures the thread will close when the main program exits.\n            processing_thread = threading.Thread(target=background_task, daemon=True)\n            processing_thread.start()\n\n        except ValueError:\n            messagebox.showerror(\"Error\", \"Please enter valid numbers for Shift Seconds, Shotting Interval, and Cores.\")\n        except Exception as e:\n            messagebox.showerror(\"Error\", f\"An unexpected error occurred: {e}\")\n\n    def browse_folder():\n        \"\"\"Opens a dialog to select the target data folder.\"\"\"\n        folder_selected = filedialog.askdirectory()\n        if folder_selected:\n            target_folder_entry.delete(0, tk.END)\n            target_folder_entry.insert(0, folder_selected)\n\n    # --- Build the GUI Window ---\n    window = tk.Tk()\n    window.title(\"EdgeDAS: Onsite Processing Framework\")\n\n    tk.Label(window, text=\"Shift Seconds:\").grid(row=0, column=0, sticky=\"w\", padx=5, pady=2)\n    shift_seconds_entry = tk.Entry(window)\n    shift_seconds_entry.grid(row=0, column=1, padx=5, pady=2)\n\n    tk.Label(window, text=\"Shotting Interval (s):\").grid(row=1, column=0, sticky=\"w\", padx=5, pady=2)\n    shotting_interval_entry = tk.Entry(window)\n    shotting_interval_entry.grid(row=1, column=1, padx=5, pady=2)\n\n    tk.Label(window, text=\"Target Data Folder:\").grid(row=2, column=0, sticky=\"w\", padx=5, pady=2)\n    target_folder_entry = tk.Entry(window, width=50)\n    target_folder_entry.grid(row=2, column=1, padx=5, pady=2, columnspan=3)\n    browse_button = tk.Button(window, text=\"Browse...\", command=browse_folder)\n    browse_button.grid(row=2, column=4, padx=5, pady=2)\n\n    tk.Label(window, text=\"Hours to Stack:\").grid(row=3, column=0, sticky=\"w\", padx=5, pady=2)\n    hours_stack_var = StringVar(window)\n    hours_options = [\"1\", \"2\", \"4\", \"6\", \"8\", \"12\", \"24\"]\n    hours_stack_menu = OptionMenu(window, hours_stack_var, *hours_options)\n    hours_stack_menu.grid(row=3, column=1, padx=5, pady=2, sticky=\"ew\")\n\n    tk.Label(window, text=\"Daily Run Time (HH:MM):\").grid(row=4, column=0, sticky=\"w\", padx=5, pady=2)\n    hour_var = StringVar(window)\n    minute_var = StringVar(window)\n    hours = [f\"{i:02d}\" for i in range(24)]\n    minutes = [f\"{i:02d}\" for i in range(60)]\n    hour_menu = OptionMenu(window, hour_var, *hours)\n    minute_menu = OptionMenu(window, minute_var, *minutes)\n    time_frame = tk.Frame(window)\n    hour_menu.pack(side=tk.LEFT)\n    tk.Label(time_frame, text=\":\").pack(side=tk.LEFT)\n    minute_menu.pack(side=tk.LEFT)\n    time_frame.grid(row=4, column=1, padx=5, pady=2, sticky=\"w\")\n\n    tk.Label(window, text=\"Cores to Use (max if blank):\").grid(row=5, column=0, sticky=\"w\", padx=5, pady=2)\n    cores_entry = tk.Entry(window)\n    cores_entry.grid(row=5, column=1, padx=5, pady=2)\n    \n    binary_cc_var = BooleanVar()\n    binary_cc_checkbox = Checkbutton(window, text=\"Use Binary Cross-Correlation\", variable=binary_cc_var)\n    binary_cc_checkbox.grid(row=6, column=0, columnspan=2, sticky=\"w\", padx=5, pady=5)\n\n    run_button = tk.Button(window, text=\"Run Processing & Schedule Daily\", command=start_processing_thread)\n    run_button.grid(row=7, column=0, columnspan=5, pady=20, padx=10, ipady=5)\n\n    # --- Load settings on startup to populate fields ---\n    saved_settings = load_settings()\n    if saved_settings:\n        shift_seconds_entry.insert(0, saved_settings.get('shift_seconds', '0'))\n        shotting_interval_entry.insert(0, saved_settings.get('shotting_interval', '30'))\n        target_folder_entry.insert(0, saved_settings.get('target_folder', ''))\n        hours_stack_var.set(saved_settings.get('hours_to_stack', '24'))\n        run_time = saved_settings.get('run_time', '00:00').split(':')\n        hour_var.set(run_time[0])\n        minute_var.set(run_time[1])\n        cores_entry.insert(0, saved_settings.get('cores', str(cpu_count())))\n        binary_cc_var.set(saved_settings.get('use_binary_cc', 'false').lower() == 'true')\n    else: # Set some sensible defaults if no settings file\n        shotting_interval_entry.insert(0, '30')\n        hours_stack_var.set('24')\n        hour_var.set('01')\n        minute_var.set('00')\n        cores_entry.insert(0, str(cpu_count()))\n\n\n    window.mainloop() # Start the GUI event loop","outputs":[],"execution_count":null,"metadata":{}}],"metadata":{"colab":{"from_bard":true},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}